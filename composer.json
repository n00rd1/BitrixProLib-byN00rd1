{
    "name": "n00rd1/bitrixprolib",
    "description": "Профессиональная PHP библиотека для комплексной интеграции бизнес-систем: Bitrix24 CRM, TrustMe цифровые подписи, MyStore управление складом и бизнес-утилиты",
    "type": "library",
    "keywords": ["bitrix", "crm", "trustme", "mystore", "php", "api", "integration", "системная-интеграция", "автоматизация", "бизнес-процессы"],
    "license": "MIT",
    "authors": [
        {
            "name": "N00rd1",
            "email": "mukhamedshin13@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "BitrixProLib\\": "src/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse src",
        "cs": "phpcs src",
        "cs:fix": "phpcbf src",
        "quality": [
            "@cs",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
